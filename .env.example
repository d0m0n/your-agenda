APP_NAME="あなた(の)次第"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# 管理者パネル(/admin)へのBasic認証。両方設定すると有効になる
# (本番環境でのみ設定し、ローカル開発では空のままにしてよい)
ADMIN_BASIC_AUTH_USERNAME=
ADMIN_BASIC_AUTH_PASSWORD=

# Stripe決済(14日間の無料トライアル終了後の課金)。未設定でもアプリ自体は
# 起動するが、トライアル終了後のペイウォールで決済画面へ進めなくなる。
# テストモードのキー(sk_test_.../pk_test_...)から始めてよい。
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Stripeダッシュボードで作成した月額プランのPrice ID(price_...)
STRIPE_PRICE_ID_MONTHLY=
CASHIER_CURRENCY=jpy
CASHIER_CURRENCY_LOCALE=ja

# 特定商取引法に基づく表記・利用規約・プライバシーポリシーに掲載する運営者情報。
# 公開前に必ず実際の内容へ差し替えること(未設定時はダミーのプレースホルダーが表示される)。
# LEGAL_OPERATOR_REPRESENTATIVEは、個人事業主が屋号(LEGAL_OPERATOR_NAME)で
# 表記する場合に必須(特定商取引法上、屋号だけでなく本名の併記が必要)。
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_REPRESENTATIVE=
LEGAL_CONTACT_EMAIL=
# trueの場合、所在地・電話番号を「請求があれば遅滞なく開示する」旨の文言に
# 代える(個人事業主向けの特例)。falseにする場合はLEGAL_ADDRESS/LEGAL_PHONEに
# 実際の値を設定すること。
LEGAL_DISCLOSE_ADDRESS_ON_REQUEST=true
LEGAL_ADDRESS=
LEGAL_PHONE=

# バックアップ(spatie/laravel-backup)失敗時・異常検知時の通知先メールアドレス。
# 未設定ならLEGAL_CONTACT_EMAILを使う(config/backup.php参照)。
BACKUP_NOTIFICATION_EMAIL=

# 本番で未知の500系エラーが発生した際の通知先メールアドレス。未設定なら
# BACKUP_NOTIFICATION_EMAIL→LEGAL_CONTACT_EMAILの順で使う(config/error_alerts.php参照)。
ERROR_ALERT_EMAIL=
# 同一エラーの通知をまとめて抑制する分数(デフォルト60分)。
ERROR_ALERT_THROTTLE_MINUTES=60

# 新規お問い合わせ受信時の通知先メールアドレス。未設定なら
# ERROR_ALERT_EMAIL→BACKUP_NOTIFICATION_EMAIL→LEGAL_CONTACT_EMAILの順で
# 使う(config/inquiry.php参照)。
INQUIRY_NOTIFICATION_EMAIL=
